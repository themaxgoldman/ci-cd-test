#!/bin/bash
set -euo pipefail
#MISE description="Print the newest staging commit past prod-release that passed Staging-CD and its acceptance tests"

usage() {
    cat <<'EOF'
Usage: mise run github:find-verified-commit [OPTIONS]

Print the newest commit on the source branch, past the base, whose
staging-cd status and staging acceptance tests both succeeded. Prints
nothing when no commit qualifies.

Options:
  --source BRANCH      Branch to search (default: staging)
  --branch NAME        Branch whose tip is the base (default: prod-release)
  --base SHA           Use this commit as the base instead of the branch tip
  --max-commits N      Give up after checking this many commits (default: 100)
  --repo OWNER/REPO    GitHub repository (default: current repo from gh)
  -h, --help           Show this help message

Environment:
  GH_TOKEN / GITHUB_TOKEN    GitHub token that can read commits, PRs and statuses

Examples:
  mise run github:find-verified-commit
  mise run github:find-verified-commit --base abc123 --max-commits 20
EOF
}

SOURCE="staging"
BRANCH="prod-release"
BASE=""
MAX_COMMITS=100
REPO=""
CD_CONTEXT="staging-cd"
ACCEPTANCE_CONTEXT="Staging – acceptance"

while [[ $# -gt 0 ]]; do
    case "$1" in
    -h | --help)
        usage
        exit 0
        ;;
    --source | --branch | --base | --max-commits | --repo)
        if [[ -z "${2:-}" ]]; then
            echo "ERROR: $1 requires a value" >&2
            usage
            exit 1
        fi
        case "$1" in
        --source) SOURCE="$2" ;;
        --branch) BRANCH="$2" ;;
        --base) BASE="$2" ;;
        --max-commits) MAX_COMMITS="$2" ;;
        --repo) REPO="$2" ;;
        esac
        shift 2
        ;;
    *)
        echo "ERROR: Unexpected argument: $1" >&2
        usage
        exit 1
        ;;
    esac
done

if [[ -z "$REPO" ]]; then
    REPO=$(gh repo view --json nameWithOwner -q '.nameWithOwner')
fi

if [[ -z "$BASE" ]]; then
    BASE=$(gh api "repos/$REPO/branches/$BRANCH" --jq '.commit.sha')
fi

tip=$(gh api "repos/$REPO/branches/$SOURCE" --jq '.commit.sha')
relation=$(gh api "repos/$REPO/compare/$BASE...$tip" --jq '.status')
case "$relation" in
ahead) ;;
identical | behind)
    echo "$SOURCE ($tip) has nothing past $BASE" >&2
    exit 0
    ;;
*)
    echo "ERROR: $SOURCE ($tip) is not ahead of $BASE: $relation" >&2
    exit 1
    ;;
esac

state_of() {
    jq -r --arg context "$2" '[.statuses[] | select(.context == $context) | .state] | first // "none"' <<<"$1"
}

is_verified() {
    local sha="$1" statuses cd acceptance
    statuses=$(gh api "repos/$REPO/commits/$sha/status?per_page=100")
    cd=$(state_of "$statuses" "$CD_CONTEXT")
    acceptance=$(state_of "$statuses" "$ACCEPTANCE_CONTEXT")
    if [[ "$cd" != "success" || "$acceptance" != "success" ]]; then
        echo "  ${sha:0:10} $CD_CONTEXT: $cd, acceptance: $acceptance" >&2
        return 1
    fi
}

candidates=()
while read -r sha; do
    candidates+=("$sha")
done < <(gh api "repos/$REPO/compare/$BASE...$tip" --jq '.commits[].sha')

checked=0
for ((i = ${#candidates[@]} - 1; i >= 0; i--)); do
    if ((checked >= MAX_COMMITS)); then
        echo "No verified commit in the newest $MAX_COMMITS candidates" >&2
        exit 0
    fi
    checked=$((checked + 1))
    if is_verified "${candidates[$i]}"; then
        echo "  ${candidates[$i]:0:10} passed every staging check" >&2
        echo "${candidates[$i]}"
        exit 0
    fi
done

echo "No commit past $BASE passed every staging check" >&2
