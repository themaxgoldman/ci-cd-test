#!/bin/bash
set -euo pipefail

REPO="${1:?usage: prepare-release OWNER/REPO}"
BASE="main"
HEAD="prod-release"
SOURCE="staging"
TITLE="Release: prod-release → main"

list_commits() {
    gh api "repos/$REPO/compare/$1...$2" --jq '.commits[] | "\(.sha) \(.commit.message | split("\n")[0])"'
}

reverse() {
    awk '{ lines[NR] = $0 } END { for (i = NR; i > 0; i--) print lines[i] }'
}

pr_entry() {
    local sha="$1" subject="$2" pr_number
    pr_number=$(grep -o '(#[0-9]\+)$' <<<"$subject" | tr -d '(#)' || true)
    if [[ -z "$pr_number" ]]; then
        echo "- ${sha:0:10} $subject"
        return
    fi
    gh api "repos/$REPO/issues/$pr_number" --jq '"- [\(.title)](\(.html_url)) (@\(.user.login))"'
}

list_prs() {
    while read -r sha subject; do
        pr_entry "$sha" "$subject"
    done < <(list_commits "$1" "$2") | reverse
}

released=$(list_prs "$BASE" "$HEAD")
not_released=$(list_prs "$HEAD" "$SOURCE")

# shellcheck disable=SC2016
body="# Release PR - $(date '+%B %-d, %Y')

> [!TIP]
> **This release is ready.** It merges at the next scheduled release. To hold it, add the \`do not merge\` label to this PR.

## Linked Issues

_No linked Linear issues found in staging._

## Unlinked Work

${released:-_No unlinked PRs found._}

## On Staging, Not In This Release

${not_released:-_Everything merged into \`$SOURCE\` is in this release._}

## Release Notes

_No additional release notes._"

pr=$(gh pr list --repo "$REPO" --base "$BASE" --head "$HEAD" --state open --json number --jq '.[0].number // empty')
if [[ -z "$pr" ]]; then
    if [[ -z "$released" ]]; then
        echo "No commits between $BASE and $HEAD. Nothing to release."
        exit 0
    fi
    gh pr create --repo "$REPO" --base "$BASE" --head "$HEAD" --title "$TITLE" --body "$body"
else
    gh api --method PATCH "repos/$REPO/pulls/$pr" -f body="$body" --silent
    echo "Updated release PR #$pr"
fi
