#!/bin/bash
set -euo pipefail
#MISE description="Start Staging-CD on the newest staging commit once the commit already in it has finished"

usage() {
    cat <<'EOF'
Usage: mise run github:advance-staging-pipeline [OPTIONS]

One commit at a time goes through Staging-CD, its deploy and its acceptance
tests. Starting a commit marks it staging-cd pending, so the commit in the
pipeline is the newest one with a staging-cd status. Once that commit has
finished, start Staging-CD on the source branch, which runs its newest
commit. Until then, do nothing.

Staging-CD replaces the pending staging-cd with its own result: success when
CI passed and the commit deployed, failure when CI failed but the commit
deployed anyway, and error when it never deployed. A commit has finished
when staging-cd is error, or when staging-cd is success or failure and its
acceptance tests reported. A commit passed when staging-cd and the
acceptance tests both succeeded.

A commit that has not finished within the timeout gets an error on whichever
of staging-cd and the acceptance tests is still missing, so it shows as
failed and is never released.

Options:
  --source BRANCH        Branch PRs merge into (default: staging)
  --workflow FILE        Workflow to start (default: staging-cd.yml)
  --timeout-minutes N    Give up on a commit after this long (default: 90)
  --repo OWNER/REPO      GitHub repository (default: current repo from gh)
  --dry-run              Report what would happen without changing anything
  -h, --help             Show this help message

Environment:
  GH_TOKEN               Token that reads and sets statuses and starts the workflow

Examples:
  mise run github:advance-staging-pipeline
  mise run github:advance-staging-pipeline --dry-run
EOF
}

SOURCE="staging"
WORKFLOW="staging-cd.yml"
TIMEOUT_MINUTES=90
REPO=""
DRY_RUN=false
CD_CONTEXT="staging-cd"
ACCEPTANCE_CONTEXT="Staging – acceptance"

while [[ $# -gt 0 ]]; do
    case "$1" in
    -h | --help)
        usage
        exit 0
        ;;
    --dry-run)
        DRY_RUN=true
        shift
        ;;
    --source | --workflow | --timeout-minutes | --repo)
        if [[ -z "${2:-}" ]]; then
            echo "ERROR: $1 requires a value" >&2
            usage
            exit 1
        fi
        case "$1" in
        --source) SOURCE="$2" ;;
        --workflow) WORKFLOW="$2" ;;
        --timeout-minutes) TIMEOUT_MINUTES="$2" ;;
        --repo) REPO="$2" ;;
        esac
        shift 2
        ;;
    *)
        echo "ERROR: Unexpected argument: $1" >&2
        usage
        exit 1
        ;;
    esac
done

if [[ -z "$REPO" ]]; then
    REPO=$(gh repo view --json nameWithOwner -q '.nameWithOwner')
fi

set_status() {
    local sha="$1" context="$2" state="$3" description="$4" url="${5:-}"
    if [[ "$DRY_RUN" == true ]]; then
        echo "Would mark ${sha:0:10} $context=$state ($description)" >&2
        return
    fi
    gh api --method POST "repos/$REPO/statuses/$sha" \
        -f state="$state" -f context="$context" -f description="$description" -f target_url="$url" --silent
}

statuses() {
    gh api "repos/$REPO/commits/$1/status?per_page=100"
}

field() {
    jq -r --arg context "$2" --arg field "$3" '[.statuses[] | select(.context == $context) | .[$field]] | first // "none"' <<<"$1"
}

started_at() {
    gh api "repos/$REPO/commits/$1/statuses?per_page=100" \
        --jq "[.[] | select(.context == \"$CD_CONTEXT\") | .created_at | fromdateiso8601] | min"
}

pipeline_state() {
    local sha="$1" statuses="$2" cd acceptance message
    cd=$(field "$statuses" "$CD_CONTEXT" state)
    acceptance=$(field "$statuses" "$ACCEPTANCE_CONTEXT" state)

    case "$cd" in
    error)
        echo failed
        return
        ;;
    success | failure)
        case "$acceptance" in
        success)
            [[ "$cd" == "success" ]] && echo passed || echo failed
            return
            ;;
        failure | error)
            echo failed
            return
            ;;
        esac
        ;;
    esac

    if (($(date -u +%s) - $(started_at "$sha") <= TIMEOUT_MINUTES * 60)); then
        echo running
        return
    fi
    message="No result within $TIMEOUT_MINUTES minutes"
    if [[ "$cd" == "success" || "$cd" == "failure" ]]; then
        set_status "$sha" "$ACCEPTANCE_CONTEXT" error "$message"
    else
        set_status "$sha" "$CD_CONTEXT" error "$message" "$(field "$statuses" "$CD_CONTEXT" target_url)"
    fi
    echo failed
}

start() {
    local run sha
    if [[ "$DRY_RUN" == true ]]; then
        echo "Would start $WORKFLOW on $SOURCE" >&2
        return
    fi
    run=$(gh api --method POST "repos/$REPO/actions/workflows/$WORKFLOW/dispatches" \
        -f ref="$SOURCE" -F return_run_details=true --jq '"\(.workflow_run_id) \(.html_url)"')
    sha=$(gh api "repos/$REPO/actions/runs/${run%% *}" --jq '.head_sha')
    set_status "$sha" "$CD_CONTEXT" pending "Waiting for Staging-CD" "${run#* }"
    echo "Started ${sha:0:10} through the pipeline in ${run#* }" >&2
}

tip=$(gh api "repos/$REPO/branches/$SOURCE" --jq '.commit.sha')

current=""
current_statuses=""
for sha in $(gh api "repos/$REPO/commits?sha=$SOURCE&per_page=100" --jq '.[].sha'); do
    current_statuses=$(statuses "$sha")
    if [[ "$(field "$current_statuses" "$CD_CONTEXT" state)" != "none" ]]; then
        current="$sha"
        break
    fi
done

if [[ -z "$current" ]]; then
    echo "Nothing has been through the pipeline yet" >&2
    start
    exit 0
fi

state=$(pipeline_state "$current" "$current_statuses")
echo "Pipeline is on ${current:0:10}: $state" >&2

if [[ "$state" == "running" ]]; then
    exit 0
fi

if [[ "$current" == "$tip" ]]; then
    echo "$SOURCE has nothing newer than ${current:0:10}" >&2
    exit 0
fi

start
