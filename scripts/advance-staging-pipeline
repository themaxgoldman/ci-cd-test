#!/bin/bash
set -euo pipefail
#MISE description="Start the newest staging commit through Staging-CD once the commit already in it has finished"

usage() {
    cat <<'EOF'
Usage: mise run github:advance-staging-pipeline [OPTIONS]

One commit at a time goes through Staging-CD, its deploy and its acceptance
tests. The commit in the pipeline is the one carrying a tag under the tag
prefix, and creating that tag is what starts Staging-CD on it. Once that
commit has finished, tag the newest commit on the source branch and drop
the old tag. Until then, do nothing.

A commit has finished when its Staging-CD run is done and either its
acceptance tests reported or its deploy never went out. A commit that has
not finished within the timeout counts as failed.

Options:
  --source BRANCH        Branch PRs merge into (default: staging)
  --tag-prefix PREFIX    Prefix of the pipeline tag (default: staging-pipeline/)
  --workflow FILE        Workflow the tag starts (default: staging-cd.yml)
  --timeout-minutes N    Give up on a commit after this long (default: 90)
  --repo OWNER/REPO      GitHub repository (default: current repo from gh)
  --dry-run              Report what would happen without changing anything
  -h, --help             Show this help message

Environment:
  GH_TOKEN               Token whose tag pushes start workflows
  STATUS_GH_TOKEN        Token for commit statuses (default: GH_TOKEN)

Examples:
  mise run github:advance-staging-pipeline
  mise run github:advance-staging-pipeline --dry-run
EOF
}

SOURCE="staging"
TAG_PREFIX="staging-pipeline/"
WORKFLOW="staging-cd.yml"
TIMEOUT_MINUTES=90
REPO=""
DRY_RUN=false
STATUS_CONTEXT="staging-pipeline"
ACCEPTANCE_CONTEXT="Staging – acceptance"

while [[ $# -gt 0 ]]; do
    case "$1" in
    -h | --help)
        usage
        exit 0
        ;;
    --dry-run)
        DRY_RUN=true
        shift
        ;;
    --source | --tag-prefix | --workflow | --timeout-minutes | --repo)
        if [[ -z "${2:-}" ]]; then
            echo "ERROR: $1 requires a value" >&2
            usage
            exit 1
        fi
        case "$1" in
        --source) SOURCE="$2" ;;
        --tag-prefix) TAG_PREFIX="$2" ;;
        --workflow) WORKFLOW="$2" ;;
        --timeout-minutes) TIMEOUT_MINUTES="$2" ;;
        --repo) REPO="$2" ;;
        esac
        shift 2
        ;;
    *)
        echo "ERROR: Unexpected argument: $1" >&2
        usage
        exit 1
        ;;
    esac
done

if [[ -z "$REPO" ]]; then
    REPO=$(gh repo view --json nameWithOwner -q '.nameWithOwner')
fi

status_api() {
    GH_TOKEN="${STATUS_GH_TOKEN:-${GH_TOKEN:-}}" gh api "$@"
}

set_status() {
    local sha="$1" state="$2" description="$3"
    if [[ "$DRY_RUN" == true ]]; then
        echo "Would mark ${sha:0:10} $STATUS_CONTEXT=$state ($description)" >&2
        return
    fi
    status_api --method POST "repos/$REPO/statuses/$sha" \
        -f state="$state" -f context="$STATUS_CONTEXT" -f description="$description" --silent
}

recorded_status() {
    gh api "repos/$REPO/commits/$1/statuses?per_page=100" \
        --jq "[.[] | select(.context == \"$STATUS_CONTEXT\")] | first // empty | \"\(.state) \(.created_at | fromdateiso8601)\""
}

pipeline_state() {
    local sha="$1" recorded="$2" run run_id run_status run_conclusion acceptance deploy

    run=$(gh api "repos/$REPO/actions/workflows/$WORKFLOW/runs?head_sha=$sha&per_page=1" \
        --jq '.workflow_runs[0] | select(. != null) | "\(.id) \(.status) \(.conclusion)"')
    read -r run_id run_status run_conclusion <<<"${run:-}"

    if [[ "${run_status:-}" == "completed" ]]; then
        acceptance=$(gh api "repos/$REPO/commits/$sha/status?per_page=100" \
            --jq "[.statuses[] | select(.context == \"$ACCEPTANCE_CONTEXT\") | .state] | first // \"none\"")
        case "$acceptance" in
        success)
            [[ "$run_conclusion" == "success" ]] && echo passed || echo failed
            return
            ;;
        failure | error)
            echo failed
            return
            ;;
        esac

        deploy=$(gh api "repos/$REPO/actions/runs/$run_id/jobs?per_page=100" \
            --jq '[.jobs[] | select(.name == "deploy") | .conclusion] | first // "none"')
        if [[ "$deploy" != "success" ]]; then
            echo failed
            return
        fi
    fi

    if [[ -z "$recorded" ]]; then
        set_status "$sha" pending "Waiting for Staging-CD, the staging deploy and acceptance tests"
        echo running
        return
    fi

    if (($(date -u +%s) - ${recorded#* } > TIMEOUT_MINUTES * 60)); then
        echo failed
        return
    fi
    echo running
}

start() {
    local sha="$1" old_tag="$2"
    if [[ "$DRY_RUN" == true ]]; then
        echo "Would tag ${sha:0:10} as $TAG_PREFIX$sha and remove ${old_tag:-no old tag}" >&2
        return
    fi
    set_status "$sha" pending "Waiting for Staging-CD, the staging deploy and acceptance tests"
    gh api --method POST "repos/$REPO/git/refs" -f ref="refs/tags/$TAG_PREFIX$sha" -f sha="$sha" --silent
    if [[ -n "$old_tag" ]]; then
        gh api --method DELETE "repos/$REPO/git/refs/tags/$old_tag" --silent
    fi
    echo "Started ${sha:0:10} through the pipeline" >&2
}

tip=$(gh api "repos/$REPO/branches/$SOURCE" --jq '.commit.sha')

tags=$(gh api "repos/$REPO/git/matching-refs/tags/$TAG_PREFIX" --jq '.[].ref | ltrimstr("refs/tags/")')
current_tag=""
current=""
for tag in $tags; do
    sha="${tag#"$TAG_PREFIX"}"
    if [[ -z "$current" ]] || [[ "$(gh api "repos/$REPO/compare/$current...$sha" --jq '.status')" == "ahead" ]]; then
        if [[ -n "$current_tag" && "$DRY_RUN" != true ]]; then
            gh api --method DELETE "repos/$REPO/git/refs/tags/$current_tag" --silent
        fi
        current_tag="$tag"
        current="$sha"
    elif [[ "$DRY_RUN" != true ]]; then
        gh api --method DELETE "repos/$REPO/git/refs/tags/$tag" --silent
    fi
done

# A commit whose tag was deleted by hand is still marked pending until it finishes.
if [[ -z "$current" ]]; then
    for sha in $(gh api "repos/$REPO/commits?sha=$SOURCE&per_page=30" --jq '.[].sha'); do
        if [[ "$(recorded_status "$sha")" == pending* ]]; then
            echo "The pipeline tag is missing, but ${sha:0:10} is still marked as running" >&2
            current="$sha"
            break
        fi
    done
fi

if [[ -z "$current" ]]; then
    echo "Nothing is in the pipeline" >&2
    start "$tip" ""
    exit 0
fi

recorded=$(recorded_status "$current")
case "${recorded%% *}" in
success) state=passed ;;
failure | error) state=failed ;;
*)
    state=$(pipeline_state "$current" "$recorded")
    case "$state" in
    passed) set_status "$current" success "Passed Staging-CD, the staging deploy and acceptance tests" ;;
    failed) set_status "$current" failure "Did not pass Staging-CD, the staging deploy and acceptance tests" ;;
    esac
    ;;
esac
echo "Pipeline is on ${current:0:10}: $state" >&2

if [[ "$state" == "running" ]]; then
    exit 0
fi

if [[ "$current" == "$tip" ]]; then
    echo "$SOURCE has nothing newer than ${current:0:10}" >&2
    exit 0
fi

relation=$(gh api "repos/$REPO/compare/$current...$tip" --jq '.status')
if [[ "$relation" != "ahead" ]]; then
    echo "ERROR: $SOURCE ($tip) is not ahead of the pipeline commit ($current): $relation" >&2
    exit 1
fi

start "$tip" "$current_tag"
