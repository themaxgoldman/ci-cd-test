#!/bin/bash
set -euo pipefail
#MISE description="Start Staging-CD on the newest staging commit once the commit already in it has finished"

usage() {
    cat <<'EOF'
Usage: mise run github:advance-staging-pipeline [OPTIONS]

One commit at a time goes through Staging-CD, its deploy and its acceptance
tests. The commit in the pipeline is the newest one marked with a pending
staging-pipeline status. Once that commit has finished, start Staging-CD on
the source branch, which runs its newest commit, and mark that commit
pending. Until then, do nothing.

A commit has finished when its Staging-CD run is done and either its
acceptance tests reported or its deploy never went out. A commit that has
not finished within the timeout counts as failed.

Commits merged while another commit was in the pipeline are skipped and
tested as part of the newer commit that runs next. They are marked pending
while it runs, then passed or failed along with it.

Options:
  --source BRANCH        Branch PRs merge into (default: staging)
  --workflow FILE        Workflow to start (default: staging-cd.yml)
  --timeout-minutes N    Give up on a commit after this long (default: 90)
  --repo OWNER/REPO      GitHub repository (default: current repo from gh)
  --dry-run              Report what would happen without changing anything
  -h, --help             Show this help message

Environment:
  GH_TOKEN               Token that reads runs and statuses, sets statuses and starts the workflow

Examples:
  mise run github:advance-staging-pipeline
  mise run github:advance-staging-pipeline --dry-run
EOF
}

SOURCE="staging"
WORKFLOW="staging-cd.yml"
TIMEOUT_MINUTES=90
REPO=""
DRY_RUN=false
STATUS_CONTEXT="staging-pipeline"
ACCEPTANCE_CONTEXT="Staging – acceptance"
NOTIFY_JOB="notify_controller"

while [[ $# -gt 0 ]]; do
    case "$1" in
    -h | --help)
        usage
        exit 0
        ;;
    --dry-run)
        DRY_RUN=true
        shift
        ;;
    --source | --workflow | --timeout-minutes | --repo)
        if [[ -z "${2:-}" ]]; then
            echo "ERROR: $1 requires a value" >&2
            usage
            exit 1
        fi
        case "$1" in
        --source) SOURCE="$2" ;;
        --workflow) WORKFLOW="$2" ;;
        --timeout-minutes) TIMEOUT_MINUTES="$2" ;;
        --repo) REPO="$2" ;;
        esac
        shift 2
        ;;
    *)
        echo "ERROR: Unexpected argument: $1" >&2
        usage
        exit 1
        ;;
    esac
done

if [[ -z "$REPO" ]]; then
    REPO=$(gh repo view --json nameWithOwner -q '.nameWithOwner')
fi

set_status() {
    local sha="$1" state="$2" description="$3" url="${4:-}"
    if [[ "$DRY_RUN" == true ]]; then
        echo "Would mark ${sha:0:10} $STATUS_CONTEXT=$state ($description)" >&2
        return
    fi
    gh api --method POST "repos/$REPO/statuses/$sha" \
        -f state="$state" -f context="$STATUS_CONTEXT" -f description="$description" -f target_url="$url" --silent
}

run_url() {
    gh api "repos/$REPO/actions/workflows/$WORKFLOW/runs?head_sha=$1&per_page=1" --jq '.workflow_runs[0].html_url // empty'
}

recorded_status() {
    gh api "repos/$REPO/commits/$1/statuses?per_page=100" \
        --jq "[.[] | select(.context == \"$STATUS_CONTEXT\")] | first // empty | \"\(.state) \(.created_at | fromdateiso8601)\""
}

waiting_description() {
    echo "Waiting: tested as part of ${1:0:10}"
}

mark_skipped() {
    local sha="$1" url="$2" skipped
    for skipped in $(gh api "repos/$REPO/compare/$current...$sha" --jq '.commits[:-1][].sha'); do
        set_status "$skipped" pending "$(waiting_description "$sha")" "$url"
    done
}

finish_skipped() {
    local sha="$1" state="$2" result="$3" url="$4" skipped description
    for skipped in $(gh api "repos/$REPO/commits?sha=$sha&per_page=100" --jq '.[1:][].sha'); do
        description=$(gh api "repos/$REPO/commits/$skipped/statuses?per_page=100" \
            --jq "[.[] | select(.context == \"$STATUS_CONTEXT\")] | first // empty | .description")
        [[ "$description" == "$(waiting_description "$sha")" ]] || break
        set_status "$skipped" "$state" "$result as part of ${sha:0:10}, not tested on its own" "$url"
    done
}

run_result() {
    local run_id="$1" run_status="$2" run_conclusion="$3" jobs
    if [[ "$run_status" == "completed" ]]; then
        echo "completed $run_conclusion"
        return
    fi
    jobs=$(gh api "repos/$REPO/actions/runs/$run_id/jobs?per_page=100")
    # The run's last job is the one that starts this check, so the run counts as done once that job has started.
    if jq -e --arg notify "$NOTIFY_JOB" 'any(.jobs[]; .name == $notify and .status != "queued" and .status != "waiting" and .status != "pending")' <<<"$jobs" >/dev/null; then
        jq -r --arg notify "$NOTIFY_JOB" '[.jobs[] | select(.name != $notify) | .conclusion]
            | if any(.[]; . == "failure" or . == "cancelled" or . == "timed_out" or . == "startup_failure") then "completed failure" else "completed success" end' <<<"$jobs"
        return
    fi
    echo "$run_status none"
}

pipeline_state() {
    local sha="$1" recorded="$2" run run_id run_status run_conclusion acceptance deploy

    run=$(gh api "repos/$REPO/actions/workflows/$WORKFLOW/runs?head_sha=$sha&per_page=1" \
        --jq '.workflow_runs[0] | select(. != null) | "\(.id) \(.status) \(.conclusion)"')
    read -r run_id run_status run_conclusion <<<"${run:-}"
    if [[ -n "${run_id:-}" ]]; then
        read -r run_status run_conclusion <<<"$(run_result "$run_id" "$run_status" "$run_conclusion")"
    fi

    if [[ "${run_status:-}" == "completed" ]]; then
        acceptance=$(gh api "repos/$REPO/commits/$sha/status?per_page=100" \
            --jq "[.statuses[] | select(.context == \"$ACCEPTANCE_CONTEXT\") | .state] | first // \"none\"")
        case "$acceptance" in
        success)
            [[ "$run_conclusion" == "success" ]] && echo passed || echo failed
            return
            ;;
        failure | error)
            echo failed
            return
            ;;
        esac

        deploy=$(gh api "repos/$REPO/actions/runs/$run_id/jobs?per_page=100" \
            --jq '[.jobs[] | select(.name == "deploy") | .conclusion] | first // "none"')
        if [[ "$deploy" != "success" ]]; then
            echo failed
            return
        fi
    fi

    if (($(date -u +%s) - ${recorded#* } > TIMEOUT_MINUTES * 60)); then
        echo failed
        return
    fi
    echo running
}

start() {
    local run sha
    if [[ "$DRY_RUN" == true ]]; then
        echo "Would start $WORKFLOW on $SOURCE" >&2
        return
    fi
    run=$(gh api --method POST "repos/$REPO/actions/workflows/$WORKFLOW/dispatches" \
        -f ref="$SOURCE" -F return_run_details=true --jq '"\(.workflow_run_id) \(.html_url)"')
    sha=$(gh api "repos/$REPO/actions/runs/${run%% *}" --jq '.head_sha')
    set_status "$sha" pending "Waiting for Staging-CD, the staging deploy and acceptance tests" "${run#* }"
    if [[ -n "$current" ]]; then
        mark_skipped "$sha" "${run#* }"
    fi
    echo "Started ${sha:0:10} through the pipeline in ${run#* }" >&2
}

tip=$(gh api "repos/$REPO/branches/$SOURCE" --jq '.commit.sha')

current=""
recorded=""
for sha in $(gh api "repos/$REPO/commits?sha=$SOURCE&per_page=100" --jq '.[].sha'); do
    recorded=$(recorded_status "$sha")
    if [[ -n "$recorded" ]]; then
        current="$sha"
        break
    fi
done

if [[ -z "$current" ]]; then
    echo "Nothing has been through the pipeline yet" >&2
    start
    exit 0
fi

case "${recorded%% *}" in
success) state=passed ;;
failure | error) state=failed ;;
*)
    state=$(pipeline_state "$current" "$recorded")
    case "$state" in
    passed)
        url=$(run_url "$current")
        set_status "$current" success "Passed Staging-CD, the staging deploy and acceptance tests" "$url"
        finish_skipped "$current" success Passed "$url"
        ;;
    failed)
        url=$(run_url "$current")
        set_status "$current" failure "Did not pass Staging-CD, the staging deploy and acceptance tests" "$url"
        finish_skipped "$current" failure Failed "$url"
        ;;
    esac
    ;;
esac
echo "Pipeline is on ${current:0:10}: $state" >&2

if [[ "$state" == "running" ]]; then
    exit 0
fi

if [[ "$current" == "$tip" ]]; then
    echo "$SOURCE has nothing newer than ${current:0:10}" >&2
    exit 0
fi

start
