#!/bin/bash
set -euo pipefail
#MISE description="Start Staging-CD on the newest staging commit once the commit already in it has finished"

usage() {
    cat <<'EOF'
Usage: mise run github:advance-staging-pipeline [OPTIONS]

One commit at a time goes through Staging-CD, its deploy and its acceptance
tests. The commit in the pipeline is the newest one with a staging-verified
status, which is pending while it runs. Once that commit has finished, mark
it staging-verified success or failure, start Staging-CD on the source
branch, which runs its newest commit, and mark that commit pending. Until
then, do nothing.

Staging-CD reports its own result as a staging-cd status: success when CI
passed and the commit deployed, failure when CI failed but the commit
deployed anyway, and error when it never deployed. A commit has finished
when staging-cd is error, or when staging-cd is success or failure and its
acceptance tests reported. It passes only when staging-cd and the acceptance
tests both succeeded. A commit that has not finished within the timeout
counts as failed.

Options:
  --source BRANCH        Branch PRs merge into (default: staging)
  --workflow FILE        Workflow to start (default: staging-cd.yml)
  --timeout-minutes N    Give up on a commit after this long (default: 90)
  --repo OWNER/REPO      GitHub repository (default: current repo from gh)
  --dry-run              Report what would happen without changing anything
  -h, --help             Show this help message

Environment:
  GH_TOKEN               Token that reads and sets statuses and starts the workflow

Examples:
  mise run github:advance-staging-pipeline
  mise run github:advance-staging-pipeline --dry-run
EOF
}

SOURCE="staging"
WORKFLOW="staging-cd.yml"
TIMEOUT_MINUTES=90
REPO=""
DRY_RUN=false
VERIFIED_CONTEXT="staging-verified"
CD_CONTEXT="staging-cd"
ACCEPTANCE_CONTEXT="Staging – acceptance"

while [[ $# -gt 0 ]]; do
    case "$1" in
    -h | --help)
        usage
        exit 0
        ;;
    --dry-run)
        DRY_RUN=true
        shift
        ;;
    --source | --workflow | --timeout-minutes | --repo)
        if [[ -z "${2:-}" ]]; then
            echo "ERROR: $1 requires a value" >&2
            usage
            exit 1
        fi
        case "$1" in
        --source) SOURCE="$2" ;;
        --workflow) WORKFLOW="$2" ;;
        --timeout-minutes) TIMEOUT_MINUTES="$2" ;;
        --repo) REPO="$2" ;;
        esac
        shift 2
        ;;
    *)
        echo "ERROR: Unexpected argument: $1" >&2
        usage
        exit 1
        ;;
    esac
done

if [[ -z "$REPO" ]]; then
    REPO=$(gh repo view --json nameWithOwner -q '.nameWithOwner')
fi

set_verified() {
    local sha="$1" state="$2" description="$3" url="${4:-}"
    if [[ "$DRY_RUN" == true ]]; then
        echo "Would mark ${sha:0:10} $VERIFIED_CONTEXT=$state ($description)" >&2
        return
    fi
    gh api --method POST "repos/$REPO/statuses/$sha" \
        -f state="$state" -f context="$VERIFIED_CONTEXT" -f description="$description" -f target_url="$url" --silent
}

statuses() {
    gh api "repos/$REPO/commits/$1/status?per_page=100"
}

field() {
    jq -r --arg context "$2" --arg field "$3" '[.statuses[] | select(.context == $context) | .[$field]] | first // "none"' <<<"$1"
}

pipeline_state() {
    local statuses="$1" cd acceptance started
    cd=$(field "$statuses" "$CD_CONTEXT" state)
    acceptance=$(field "$statuses" "$ACCEPTANCE_CONTEXT" state)

    case "$cd" in
    error)
        echo failed
        return
        ;;
    success | failure)
        case "$acceptance" in
        success)
            [[ "$cd" == "success" ]] && echo passed || echo failed
            return
            ;;
        failure | error)
            echo failed
            return
            ;;
        esac
        ;;
    esac

    started=$(jq -r --arg context "$VERIFIED_CONTEXT" '[.statuses[] | select(.context == $context) | .created_at | fromdateiso8601] | first' <<<"$statuses")
    if (($(date -u +%s) - started > TIMEOUT_MINUTES * 60)); then
        echo failed
        return
    fi
    echo running
}

start() {
    local run sha
    if [[ "$DRY_RUN" == true ]]; then
        echo "Would start $WORKFLOW on $SOURCE" >&2
        return
    fi
    run=$(gh api --method POST "repos/$REPO/actions/workflows/$WORKFLOW/dispatches" \
        -f ref="$SOURCE" -F return_run_details=true --jq '"\(.workflow_run_id) \(.html_url)"')
    sha=$(gh api "repos/$REPO/actions/runs/${run%% *}" --jq '.head_sha')
    set_verified "$sha" pending "Waiting for Staging-CD, the staging deploy and acceptance tests" "${run#* }"
    echo "Started ${sha:0:10} through the pipeline in ${run#* }" >&2
}

tip=$(gh api "repos/$REPO/branches/$SOURCE" --jq '.commit.sha')

current=""
current_statuses=""
for sha in $(gh api "repos/$REPO/commits?sha=$SOURCE&per_page=100" --jq '.[].sha'); do
    current_statuses=$(statuses "$sha")
    if [[ "$(field "$current_statuses" "$VERIFIED_CONTEXT" state)" != "none" ]]; then
        current="$sha"
        break
    fi
done

if [[ -z "$current" ]]; then
    echo "Nothing has been through the pipeline yet" >&2
    start
    exit 0
fi

case "$(field "$current_statuses" "$VERIFIED_CONTEXT" state)" in
success) state=passed ;;
failure | error) state=failed ;;
*)
    state=$(pipeline_state "$current_statuses")
    url=$(field "$current_statuses" "$VERIFIED_CONTEXT" target_url)
    case "$state" in
    passed) set_verified "$current" success "Passed Staging-CD, the staging deploy and acceptance tests" "$url" ;;
    failed) set_verified "$current" failure "Did not pass Staging-CD, the staging deploy and acceptance tests" "$url" ;;
    esac
    ;;
esac
echo "Pipeline is on ${current:0:10}: $state" >&2

if [[ "$state" == "running" ]]; then
    exit 0
fi

if [[ "$current" == "$tip" ]]; then
    echo "$SOURCE has nothing newer than ${current:0:10}" >&2
    exit 0
fi

start
